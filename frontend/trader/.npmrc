# @react-three/drei@10 declares a peer of react@^19 while this app is on
# react@18, so npm's strict peer resolution aborts every install with
# ERESOLVE. The Dockerfile already works around it by hard-coding
# `npm ci --legacy-peer-deps`; this file makes plain `npm install` and any
# tool that shells out to npm (shadcn, for one) behave the same way
# instead of failing.
#
# Remove this once the app moves to react@19 — or once drei is pinned back
# to a v9 release that supports react@18. Until then it is load-bearing.
legacy-peer-deps=true
