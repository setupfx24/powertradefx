# PowerTradeFX admin frontend — server-side configuration.
# Copy to .env.local for `next dev`. In Docker these come from docker-compose*.yml.

# Internal origin of the admin FastAPI service that /admin-api/* is proxied to.
# Origin only; any path component is ignored.
ADMIN_API_PROXY_TARGET=http://127.0.0.1:8001

# CSRF allowlist for the /admin-api proxy (comma-separated full origins, with
# scheme). REQUIRED in production and authoritative when set: a mutating
# request whose Origin is not listed is refused before it reaches the API.
# Leave unset in local dev to derive "self" from the request Host header.
#ADMIN_ALLOWED_ORIGINS=https://admin.powertradefx.com

# Only set to 1 if a proxy in front of Next SETS X-Forwarded-Host. The
# reference nginx config overwrites Host instead, so this stays off.
#ADMIN_TRUST_FORWARDED_HOST=0

# Name of the HttpOnly admin session cookie issued by the backend.
#ADMIN_COOKIE_NAME=fx_admin

# Upstream request timeout for the proxy, in milliseconds (1000–600000).
#ADMIN_API_PROXY_TIMEOUT_MS=120000
