# PowerTradeFX admin frontend — server-side configuration.
# Copy to .env.local for `next dev`. In Docker these come from docker-compose*.yml.

# Internal origin of the admin FastAPI service that /admin-api/* is proxied to.
# Origin only; any path component is ignored.
ADMIN_API_PROXY_TARGET=http://127.0.0.1:8001

# Internal origin of the gateway that the /api/* rewrite (next.config.mjs)
# targets, e.g. the public white-label branding lookup on the login page.
#GATEWAY_INTERNAL_URL=http://127.0.0.1:8000

# CSRF allowlist for the /admin-api proxy (comma-separated full origins, with
# scheme). REQUIRED in production: a mutating request whose Origin is neither
# listed here nor equal to the origin the request itself was addressed to
# (nginx-set Host + X-Forwarded-Proto) is refused before it reaches the API.
# White-label tenant admin hosts (admin.<broker-domain>) therefore need no
# entry — they are same-origin by construction. Leave unset in local dev.
#ADMIN_ALLOWED_ORIGINS=https://admin.powertradefx.com

# Only set to 1 if a proxy in front of Next SETS X-Forwarded-Host. The
# reference nginx config (platform block and provisioned tenant blocks) sets
# Host instead, so this stays off — otherwise a client-supplied
# X-Forwarded-Host would drive the backend's admin-host isolation.
#ADMIN_TRUST_FORWARDED_HOST=0

# Name of the HttpOnly admin session cookie issued by the backend
# (backend/services/admin/dependencies.py ADMIN_COOKIE_NAME).
#ADMIN_COOKIE_NAME=fx_admin

# Upstream request timeout for the proxy, in milliseconds (1000–600000).
#ADMIN_API_PROXY_TIMEOUT_MS=120000
